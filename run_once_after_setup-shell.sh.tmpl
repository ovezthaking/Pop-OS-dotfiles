#!/usr/bin/env bash

set -e

echo "Running final shell setup..."

# =========================================
# PATH
# =========================================

export PATH="$HOME/.local/bin:$PATH"

# =========================================
# Default shell -> zsh
# =========================================

if [ "$SHELL" != "$(which zsh)" ]; then
    echo "Setting zsh as default shell..."
    chsh -s "$(which zsh)"
fi

# =========================================
# Oh My Zsh plugins
# =========================================

ZSH_CUSTOM="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"

mkdir -p "$ZSH_CUSTOM/plugins"

clone_if_missing() {
    REPO="$1"
    TARGET="$2"

    if [ ! -d "$TARGET" ]; then
        git clone "$REPO" "$TARGET"
    fi
}

echo "Installing zsh plugins..."

clone_if_missing \
    https://github.com/zsh-users/zsh-autosuggestions \
    "$ZSH_CUSTOM/plugins/zsh-autosuggestions"

clone_if_missing \
    https://github.com/zsh-users/zsh-syntax-highlighting \
    "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting"

clone_if_missing \
    https://github.com/Aloxaf/fzf-tab \
    "$ZSH_CUSTOM/plugins/fzf-tab"

# =========================================
# Starship prompt
# =========================================

if ! command -v starship >/dev/null 2>&1; then
    echo "Installing starship..."
    curl -sS https://starship.rs/install.sh | sh -s -- -y
fi

# =========================================
# Mise activation
# =========================================

if command -v mise >/dev/null 2>&1; then
    mise activate zsh >> ~/.zshrc || true
fi

# =========================================
# Docker permissions
# =========================================

if groups "$USER" | grep -qv docker; then
    sudo usermod -aG docker "$USER"
fi

# =========================================
# Create useful directories
# =========================================

mkdir -p \
    "$HOME/projects" \
    "$HOME/scripts" \
    "$HOME/.config"

# =========================================
# VSCode extensions
# =========================================

if command -v code >/dev/null 2>&1; then
    if [ -f "$HOME/.vscode-extensions.txt" ]; then
        echo "Installing VSCode extensions..."

        cat "$HOME/.vscode-extensions.txt" \
            | xargs -L 1 code --install-extension || true
    fi
fi

# =========================================
# Final message
# =========================================

echo ""
echo "Shell setup complete"
echo "Restart terminal or log out for full effect"
